package templates

import "github.com/wadahiro/fedlens/internal/ui/templates/components"

// NavTab represents a single navigation tab.
type NavTab struct {
	Label    string
	BaseURL  string
	Active   bool
	Protocol string // "oidc" or "saml"
}

// Section represents a collapsible section for sidebar navigation.
type Section struct {
	ID        string
	Label     string
	Timestamp string    // Timestamp display (e.g. "15:04:05 JST")
	Dot       string    // "login", "refresh", "reauth", "error", "" (no dot)
	Children  []Section // Sub-sections (e.g. Identity & Claims, Signature, etc.)
}

// ResourceAccessItem represents a resource access dropdown menu entry.
type ResourceAccessItem struct {
	Label string
	URL   string
}

// PageInfo holds layout metadata for every page.
type PageInfo struct {
	Tabs              []NavTab
	ActiveTab         NavTab
	Status            string // "connected" or "disconnected"
	StatusLabel       string // "Active Session" or "No Session"
	LoginURL          string
	LoginOptions      *components.RequestOptions // optional request options for the Login button
	ReauthOptions     *components.RequestOptions // ... for the default Re-authenticate button
	LogoutOptions     *components.RequestOptions // ... for the Logout button
	LogoutURL         string
	UserInfoURL       string
	IntrospectionURL      string // Token Introspection URL (if endpoint available)
	RevokeAccessTokenURL  string // Revoke Access Token URL (if revocation endpoint available)
	RevokeRefreshTokenURL string // Revoke Refresh Token URL (if revocation endpoint and refresh token available)
	RefreshURL            string
	ClearURL          string // path to clear debug results
	ResourceAccessItems  []ResourceAccessItem
	Sections             []Section // debug results (RESULTS)

	// Export fields. When InlineCSS is non-empty the page is being rendered as a
	// standalone file: assets are inlined instead of linked, and controls that
	// would post back to a server are omitted.
	InlineCSS  string
	InlineJS   string
	ExportedAt string // RFC 3339 timestamp shown in the export banner
	ExportURL  string // path to download the standalone export; empty while exporting
	References        []Section // reference info (REFERENCE)
	DefaultTheme      string    // "light", "dark", or "auto"
}

// OptionSets lists the request options of the buttons shown on the page, in the
// order the buttons appear.
func (p PageInfo) OptionSets() []components.RequestOptions {
	var sets []components.RequestOptions
	for _, o := range []*components.RequestOptions{p.LoginOptions, p.ReauthOptions, p.LogoutOptions} {
		if o != nil {
			sets = append(sets, *o)
		}
	}
	return sets
}

func sidebarBadgeClass(dot string) string {
	switch dot {
	case "login":
		return "result-login"
	case "refresh":
		return "result-refresh"
	case "userinfo":
		return "result-refresh"
	case "introspection":
		return "result-refresh"
	case "resource":
		return "result-refresh"
	case "revocation":
		return "result-revocation"
	case "reauth":
		return "result-reauth"
	case "logout":
		return "result-logout"
	case "error":
		return "result-error"
	default:
		return ""
	}
}

func sidebarBadgeLabel(dot string) string {
	switch dot {
	case "login":
		return "Login"
	case "refresh":
		return "Refresh"
	case "userinfo":
		return "UserInfo"
	case "introspection":
		return "Introspection"
	case "resource":
		return "Resource"
	case "revocation":
		return "Revocation"
	case "reauth":
		return "Re-auth"
	case "logout":
		return "Logout"
	case "error":
		return "Error"
	default:
		return ""
	}
}

templ Layout(title string, page PageInfo) {
	<!DOCTYPE html>
	<html lang="en" data-default-theme={ page.DefaultTheme }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - fedlens</title>
			if page.InlineCSS != "" {
				@templ.Raw("<style>" + page.InlineCSS + "</style>")
				@templ.Raw("<script>" + page.InlineJS + "</script>")
			} else {
				<link rel="stylesheet" href="/static/pico.min.css"/>
				<link rel="stylesheet" href="/static/prism.min.css"/>
				<link rel="stylesheet" href="/static/app.css"/>
				<script src="/static/htmx.min.js"></script>
				<script src="/static/prism.min.js"></script>
			}
			<script>
				// Apply theme immediately to prevent FOUC
				(function() {
					var stored = localStorage.getItem("fedlens-theme");
					if (stored) {
						document.documentElement.setAttribute("data-theme", stored);
						return;
					}
					var defaultTheme = document.documentElement.getAttribute("data-default-theme") || "auto";
					if (defaultTheme === "light" || defaultTheme === "dark") {
						document.documentElement.setAttribute("data-theme", defaultTheme);
					} else if (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) {
						document.documentElement.setAttribute("data-theme", "dark");
					}
				})();
			</script>
		</head>
		<body>
			if page.ExportedAt != "" {
				<div class="export-banner">
					<strong>Exported from fedlens</strong> at { page.ExportedAt } — a standalone copy of the debug timeline.
					Interactive controls are omitted. <strong>This file contains the credentials shown below,
					including access and refresh tokens.</strong> Treat it as a secret before attaching it to a ticket or sharing it.
				</div>
			}
			<!-- Sticky Header -->
			<header class="site-header">
				<div class="header-content">
					<span class="brand">
						<svg class="brand-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" width="28" height="28">
							<defs>
								<linearGradient id="lens-grad" x1="0%" y1="0%" x2="100%" y2="100%">
									<stop offset="0%" stop-color="#3B82F6"/>
									<stop offset="100%" stop-color="#06B6D4"/>
								</linearGradient>
							</defs>
							<circle cx="48" cy="48" r="42" stroke="url(#lens-grad)" stroke-width="6" fill="none"/>
							<circle cx="48" cy="48" r="32" fill="url(#lens-grad)" fill-opacity="0.1"/>
							<line x1="16" y1="30" x2="80" y2="30" stroke="currentColor" stroke-width="2.5" stroke-opacity="0.3" stroke-dasharray="5 4"/>
							<line x1="10" y1="48" x2="86" y2="48" stroke="url(#lens-grad)" stroke-width="3" stroke-opacity="0.6"/>
							<line x1="16" y1="66" x2="80" y2="66" stroke="currentColor" stroke-width="2.5" stroke-opacity="0.3" stroke-dasharray="5 4"/>
						</svg>
						<span class="brand-text">
							<span class="brand-fed">fed</span><span class="brand-lens">lens</span>
						</span>
					</span>
					<div class="header-status">
						<span class="header-protocol-label">
							if page.ActiveTab.Protocol == "oidc" {
								OIDC RP: { page.ActiveTab.Label }
							} else if page.ActiveTab.Protocol == "oauth2" {
								OAuth2 Client: { page.ActiveTab.Label }
							} else {
								SAML SP: { page.ActiveTab.Label }
							}
						</span>
					</div>
					<div class="header-actions">
						<span class={ "status-indicator", templ.KV("status-connected", page.Status == "connected"), templ.KV("status-disconnected", page.Status == "disconnected") }>
							{ page.StatusLabel }
						</span>
						<a href="#" class="theme-toggle" onclick="toggleTheme(); return false;">
							<span class="theme-toggle-icon">&#9790;</span>
						</a>
					</div>
				</div>
			</header>
			<script>
				// Measure header height immediately to prevent layout shift
				(function() {
					var h = document.querySelector(".site-header");
					if (h) document.documentElement.style.setProperty("--header-height", h.offsetHeight + "px");
				})();
			</script>
			<div class="app-layout">
				<!-- Sidebar (PC only) -->
				<aside class="sidebar">
					<nav>
						if len(page.Tabs) > 0 {
							<p class="sidebar-heading">APPS</p>
						}
						<ul>
							for _, tab := range page.Tabs {
								<li>
									if tab.Active {
										<a href={ templ.SafeURL(tab.BaseURL + "/") } aria-current="page">
											if tab.Protocol == "oidc" {
												<kbd class="protocol-oidc">OIDC</kbd>
											} else if tab.Protocol == "oauth2" {
												<kbd class="protocol-oauth2">OAUTH2</kbd>
											} else {
												<kbd class="protocol-saml">SAML</kbd>
											}
											{ tab.Label }
										</a>
									} else {
										<a href={ templ.SafeURL(tab.BaseURL + "/") }>
											if tab.Protocol == "oidc" {
												<kbd class="protocol-oidc">OIDC</kbd>
											} else if tab.Protocol == "oauth2" {
												<kbd class="protocol-oauth2">OAUTH2</kbd>
											} else {
												<kbd class="protocol-saml">SAML</kbd>
											}
											{ tab.Label }
										</a>
									}
								</li>
							}
						</ul>
						if len(page.Sections) > 0 {
							<div class="sidebar-results-header">
								<p class="sidebar-heading">RESULTS</p>
								<div class="sidebar-results-actions">
									if page.ExportURL != "" {
										<a href={ templ.SafeURL(page.ExportURL) } class="results-btn" data-testid="export-btn" download>Export</a>
									}
									if page.ClearURL != "" {
										<a href={ templ.SafeURL(page.ClearURL) } class="results-btn results-btn-danger" onclick="return confirm('Clear all results?')">Clear</a>
									}
								</div>
							</div>
							<ul class="sidebar-section-list">
								for _, sec := range page.Sections {
									<li>
										<a href={ templ.SafeURL("#" + sec.ID) } class={ templ.KV("sidebar-dot-login", sec.Dot == "login"), templ.KV("sidebar-dot-refresh", sec.Dot == "refresh"), templ.KV("sidebar-dot-userinfo", sec.Dot == "userinfo"), templ.KV("sidebar-dot-reauth", sec.Dot == "reauth"), templ.KV("sidebar-dot-introspection", sec.Dot == "introspection"), templ.KV("sidebar-dot-resource", sec.Dot == "resource"), templ.KV("sidebar-dot-revocation", sec.Dot == "revocation"), templ.KV("sidebar-dot-logout", sec.Dot == "logout"), templ.KV("sidebar-dot-error", sec.Dot == "error") }>
											<span class="sidebar-entry-content">
												if sec.Timestamp != "" {
													<small class="sidebar-timestamp">{ sec.Timestamp }</small>
												}
												if sec.Dot == "error" && sec.Label != "" {
													<kbd class={ "sidebar-badge", sidebarBadgeClass(sec.Dot) }>Error: { sec.Label }</kbd>
												} else if sec.Dot != "" {
													<kbd class={ "sidebar-badge", sidebarBadgeClass(sec.Dot) }>{ sidebarBadgeLabel(sec.Dot) }</kbd>
												} else {
													{ sec.Label }
												}
											</span>
										</a>
										if len(sec.Children) > 0 {
											<ul class="sidebar-subsection-list">
												for _, child := range sec.Children {
													<li><a href={ templ.SafeURL("#" + child.ID) }>{ child.Label }</a></li>
												}
											</ul>
										}
									</li>
								}
							</ul>
						}
						if len(page.References) > 0 {
							<p class="sidebar-heading">REFERENCE</p>
							<ul class="sidebar-section-list">
								for _, ref := range page.References {
									<li><a href={ templ.SafeURL("#" + ref.ID) }>{ ref.Label }</a></li>
								}
							</ul>
						}
					</nav>
				</aside>
				<!-- Main Content -->
				<main class="main-content">
					<!-- Mobile tabs (hidden on PC); omitted in an export, where the links are dead -->
					<div class={ "mobile-tabs", templ.KV("is-hidden", len(page.Tabs) == 0) }>
						for _, tab := range page.Tabs {
							if tab.Active {
								<a href={ templ.SafeURL(tab.BaseURL + "/") } aria-current="page">
									if tab.Protocol == "oidc" {
										<kbd class="protocol-oidc">OIDC</kbd>
									} else if tab.Protocol == "oauth2" {
										<kbd class="protocol-oauth2">OAUTH2</kbd>
									} else {
										<kbd class="protocol-saml">SAML</kbd>
									}
									{ tab.Label }
								</a>
							} else {
								<a href={ templ.SafeURL(tab.BaseURL + "/") }>
									if tab.Protocol == "oidc" {
										<kbd class="protocol-oidc">OIDC</kbd>
									} else if tab.Protocol == "oauth2" {
										<kbd class="protocol-oauth2">OAUTH2</kbd>
									} else {
										<kbd class="protocol-saml">SAML</kbd>
									}
									{ tab.Label }
								</a>
							}
						}
					</div>
					{ children... }
				</main>
			</div>
			<script>
				function toggleTheme() {
					var current = document.documentElement.getAttribute("data-theme");
					var next = (current === "dark") ? "light" : "dark";
					document.documentElement.setAttribute("data-theme", next);
					localStorage.setItem("fedlens-theme", next);
					updateThemeIcon();
				}
				function updateThemeIcon() {
					var el = document.querySelector(".theme-toggle-icon");
					if (!el) return;
					var current = document.documentElement.getAttribute("data-theme");
					el.textContent = (current === "dark") ? "\u2600" : "\u263E";
				}
				// Clipboard helper (fallback for non-HTTPS)
				function writeToClipboard(text) {
					if (navigator.clipboard && navigator.clipboard.writeText) {
						return navigator.clipboard.writeText(text);
					}
					var ta = document.createElement("textarea");
					ta.value = text;
					ta.style.position = "fixed";
					ta.style.left = "-9999px";
					document.body.appendChild(ta);
					ta.select();
					try { document.execCommand("copy"); } catch(e) {}
					document.body.removeChild(ta);
					return Promise.resolve();
				}
				// Copy code block content
				function copyToClipboard(btn) {
					var code = btn.closest("article").querySelector("code");
					if (code) {
						writeToClipboard(code.textContent);
						btn.textContent = "Copied!";
						setTimeout(function() { btn.textContent = "Copy"; }, 2000);
					}
				}
				// Copy token part (next sibling pre's code content)
				function copyTokenPart(btn) {
					var pre = btn.closest(".token-part-header").nextElementSibling;
					if (pre) {
						var code = pre.querySelector("code");
						if (code) {
							writeToClipboard(code.textContent);
							btn.textContent = "Copied!";
							setTimeout(function() { btn.textContent = "Copy"; }, 2000);
						}
					}
				}
				// Copy subject value
				function copySubjectValue(btn, value) {
					writeToClipboard(value);
					btn.textContent = "Copied!";
					setTimeout(function() { btn.textContent = "Copy"; }, 2000);
				}
				// Copy claims table as JSON
				function copyClaimsAsJSON(tableId) {
					var table = document.getElementById(tableId);
					if (!table) return;
					var obj = {};
					table.querySelectorAll("tbody tr").forEach(function(row) {
						var cells = row.querySelectorAll("td");
						if (cells.length === 2) obj[cells[0].textContent.trim()] = cells[1].textContent.trim();
					});
					writeToClipboard(JSON.stringify(obj, null, 2));
					var btn = table.closest(".section-group, details, article").querySelector(".copy-json-btn");
					if (btn) { btn.textContent = "Copied!"; setTimeout(function() { btn.textContent = "Copy as JSON"; }, 2000); }
				}
				// Request options. Every button that has options gets a split caret, and all
				// of their forms live in one card. The caret is the only way in: it shows that
				// button's form, headed by its name, with a triangle on the card pointing at
				// the caret. The card exists only while open; the count on each caret says
				// which buttons have modified values. One delegated handler
				// drives all of it, so another button only needs its options passed to the
				// templates.
				function roCard() {
					return document.querySelector('[data-testid="options-card"]');
				}
				function roForm(id) {
					return document.querySelector('form.request-options-form[data-ro-id="' + id + '"]');
				}
				// What the selected preset (a re-authentication profile) sets, by field name.
				function roPresetValues(form) {
					var select = form.querySelector(".ro-preset select");
					if (!select) return {};
					var option = select.options[select.selectedIndex];
					try { return option && option.dataset.values ? JSON.parse(option.dataset.values) : {}; } catch (e) { return {}; }
				}
				// What a field started with: the config file's value ("" when it set none).
				function roInitial(el) {
					if (el.tagName === "SELECT") {
						for (var i = 0; i < el.options.length; i++) if (el.options[i].defaultSelected) return el.options[i].value;
						return el.options.length ? el.options[0].value : "";
					}
					return el.defaultValue;
				}
				// A field is modified when it differs from what it started with. Clearing a
				// field that started with a value counts, since it stops that parameter being sent.
				function roIsChanged(el) {
					return el.tagName === "SELECT" ? el.value !== roInitial(el) : el.value !== el.defaultValue;
				}
				function roShort(text, max) {
					var t = text.replace(/\s+/g, " ").trim();
					return t.length > max ? t.slice(0, max) + "\u2026" : t;
				}
				// Show the preset's values as the placeholders of the blank fields it would fill
				// in, and say on each field it sets what the profile does there: a field left
				// as it started is overruled by the profile, a field changed overrides it.
				function roApplyPreset(form) {
					var values = roPresetValues(form);
					Array.prototype.forEach.call(form.elements, function(el) {
						if (!el.name || el.closest(".ro-preset")) return;
						var inherited = Object.prototype.hasOwnProperty.call(values, el.name) ? values[el.name] : null;
						var blank = el.value.trim() === "";
						if (el.tagName === "SELECT") {
							var first = el.options[0];
							if (first.dataset.orig === undefined) first.dataset.orig = first.textContent;
							first.textContent = inherited !== null && blank ? "(" + inherited + ")" : first.dataset.orig;
						} else {
							if (el.dataset.orig === undefined) el.dataset.orig = el.placeholder;
							el.placeholder = inherited !== null ? inherited : el.dataset.orig;
						}
						var label = el.closest("label");
						if (!label) return;
						var changed = roIsChanged(el), initial = roInitial(el);
						// Said on the field itself: what it does to the config's value, and to the profile's.
						var configFlag = label.querySelector(".ro-flag-config"), profileFlag = label.querySelector(".ro-flag-profile");
						if (configFlag) {
							configFlag.hidden = !(changed && initial !== "");
							configFlag.textContent = blank ? "config removed" : "overrides config";
						}
						if (profileFlag) {
							profileFlag.hidden = inherited === null;
							if (inherited !== null) profileFlag.textContent = changed && !blank ? "overrides profile" : "profile";
						}
					});
				}
				function roChanges(form) {
					var changes = [];
					Array.prototype.forEach.call(form.elements, function(el) {
						if (!el.name || !roIsChanged(el)) return;
						var value = el.value.trim();
						if (value === "") { changes.push(el.name + " removed"); return; }
						var option = el.tagName === "SELECT" ? el.options[el.selectedIndex] : null;
						if (option && option.dataset.short) value = option.dataset.short;
						changes.push(el.name + "=" + roShort(value, 24));
					});
					return changes;
				}
				function renderRequestOptions() {
					var card = roCard();
					if (!card) return;
					var open = card.dataset.open === "true", active = card.dataset.active;
					var shownCaret = null;
					document.querySelectorAll("form.request-options-form").forEach(function(form) {
						var id = form.dataset.roId;
						roApplyPreset(form);
						var changes = roChanges(form), modified = changes.length > 0;
						var shown = open && id === active;
						var body = card.querySelector('.ro-body[data-ro-id="' + id + '"]');
						body.hidden = !shown;
						body.querySelector(".ro-summary").textContent = modified
							? changes.length + " modified: " + changes.join(", ")
							: "Fields start with your config. A blank field sends nothing, or the faint value if there is one.";
						body.querySelector(".ro-reset").hidden = !modified;
						var caret = document.querySelector('[data-testid="' + id + '-options-toggle"]');
						if (caret) {
							var count = caret.querySelector(".ro-count");
							count.textContent = String(changes.length);
							count.hidden = !modified;
							caret.setAttribute("aria-expanded", String(shown));
							caret.parentElement.classList.toggle("is-open", shown);
							// With the card closed the count is all the bar shows, so the values
							// are one hover away.
							caret.title = body.dataset.label + " options" + (modified ? ": " + changes.join(", ") : "");
						}
						if (shown) {
							shownCaret = caret;
							card.dataset.danger = body.dataset.danger;
							card.querySelector(".ro-title").textContent = body.dataset.label + " options";
						}
					});
					if (!open) card.dataset.danger = "false";
					card.hidden = !open;
					roLink(card, shownCaret);
					roFit(card);
				}
				// The card grows with its form, so the bar can end up taller than the window.
				// A sticky bar that tall has an unreachable lower part: let it scroll with
				// the page for as long as it is.
				function roFit(card) {
					var bar = card.parentElement;
					bar.classList.remove("ro-tall");
					var headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-height")) || 0;
					if (!card.hidden && bar.offsetHeight > window.innerHeight - headerHeight) bar.classList.add("ro-tall");
					// leaving sticky shifts the card; the triangle's gap is measured again
					if (bar.classList.contains("ro-tall")) roLink(card, document.querySelector('.split-btn.is-open .split-caret'));
				}
				// Point the card's heading at the open button: a triangle whose tip touches the
				// caret. The card sits in the action bar below the row of buttons, so it only
				// has to cross the gap between the caret and the card; when the caret is not on
				// the last row (a narrow window wrapped the bar) there is no clear way down and
				// the triangle is left out.
				function roLink(card, caret) {
					var linked = false;
					if (caret && !card.hidden && card.dataset.open === "true") {
						var g = caret.getBoundingClientRect(), c = card.getBoundingClientRect();
						var gap = c.top - g.bottom;
						var rowBelow = false;
						Array.prototype.forEach.call(card.parentElement.children, function(el) {
							if (el === card || el.hidden) return;
							var r = el.getBoundingClientRect();
							if (r.top >= g.bottom - 1 && r.top < c.top) rowBelow = true;
						});
						linked = gap >= 0 && gap < 48 && !rowBelow;
						card.style.setProperty("--tab-x", (g.left - c.left) + "px");
						card.style.setProperty("--tab-w", g.width + "px");
						card.style.setProperty("--tab-gap", Math.max(gap, 0) + "px");
					}
					card.dataset.linked = String(linked);
				}
				document.addEventListener("click", function(e) {
					var t = e.target.closest(".split-caret, .ro-collapse, .ro-reset");
					var card = roCard();
					if (!t || !card) return;
					var open = card.dataset.open === "true";
					if (t.classList.contains("ro-reset")) {
						var form = roForm(t.dataset.roId);
						if (form) { form.reset(); saveRequestOptions(form); }
					} else if (t.classList.contains("ro-collapse")) {
						card.dataset.open = "false";
					} else {
						// The caret of the button whose options are shown closes the card.
						if (open && card.dataset.active === t.dataset.roId) card.dataset.open = "false";
						else { card.dataset.open = "true"; card.dataset.active = t.dataset.roId; }
					}
					renderRequestOptions();
				});
				document.addEventListener("input", function(e) {
					var form = e.target.closest("form.request-options-form");
					if (!form) return;
					saveRequestOptions(form);
					renderRequestOptions();
				});
				window.addEventListener("resize", renderRequestOptions);
				// Switching apps in the sidebar loads another page, which would drop what was
				// typed. Keep it for the life of this browser tab, per app: the form's action
				// is unique to each app. Storage can be blocked, so every access is guarded.
				function requestOptionsKey(form) {
					return "fedlens.request-options:" + form.getAttribute("action");
				}
				function saveRequestOptions(form) {
					var values = {};
					Array.prototype.forEach.call(form.elements, function(el) {
						if (el.name && roIsChanged(el)) values[el.name] = el.value;
					});
					try {
						if (Object.keys(values).length) sessionStorage.setItem(requestOptionsKey(form), JSON.stringify(values));
						else sessionStorage.removeItem(requestOptionsKey(form));
					} catch (e) {}
				}
				function restoreRequestOptions() {
					document.querySelectorAll("form.request-options-form").forEach(function(form) {
						var values;
						try { values = JSON.parse(sessionStorage.getItem(requestOptionsKey(form)) || "null"); } catch (e) {}
						if (!values) return;
						Array.prototype.forEach.call(form.elements, function(el) {
							if (el.name && Object.prototype.hasOwnProperty.call(values, el.name)) el.value = values[el.name];
						});
					});
					renderRequestOptions();
				}
				if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", restoreRequestOptions);
				else restoreRequestOptions();
				// Dropdown toggle
				function toggleDropdown(btn) {
					var menu = btn.nextElementSibling;
					if (!menu) return;
					var isOpen = menu.classList.contains("show");
					// Close all dropdowns first
					document.querySelectorAll(".dropdown-menu.show").forEach(function(m) { m.classList.remove("show"); });
					if (!isOpen) menu.classList.add("show");
				}
				// Close dropdowns on outside click
				document.addEventListener("click", function(e) {
					if (!e.target.closest(".dropdown")) {
						document.querySelectorAll(".dropdown-menu.show").forEach(function(m) { m.classList.remove("show"); });
					}
				});
				// Scroll spy: observe all details[id] on page
				var scrollSpyObserver = null;
				var visibleSections = new Set();
				var scrollSpyPaused = false;
				function updateScrollSpyHighlight() {
					if (scrollSpyPaused) return;
					document.querySelectorAll(".sidebar-section-list a[aria-current]").forEach(function(a) {
						a.removeAttribute("aria-current");
					});
					if (visibleSections.size === 0) return;
					// Among visible sections, prefer subsections over parents
					var subsections = [];
					var others = [];
					visibleSections.forEach(function(el) {
						if (el.classList.contains("result-subsection")) {
							subsections.push(el);
						} else {
							others.push(el);
						}
					});
					var candidates = subsections.length > 0 ? subsections : others;
					// Pick the one closest to the top of the viewport
					var best = null;
					var bestTop = Infinity;
					candidates.forEach(function(el) {
						var top = el.getBoundingClientRect().top;
						if (top < bestTop) {
							bestTop = top;
							best = el;
						}
					});
					if (best) {
						var link = document.querySelector('.sidebar-section-list a[href="#' + best.getAttribute("id") + '"]');
						if (link) {
							link.setAttribute("aria-current", "true");
						}
					}
				}
				function setupScrollSpy() {
					if (scrollSpyObserver) {
						scrollSpyObserver.disconnect();
					}
					visibleSections.clear();
					document.querySelectorAll(".sidebar-section-list a[aria-current]").forEach(function(a) {
						a.removeAttribute("aria-current");
					});
					var sectionEls = document.querySelectorAll("details[id]");
					if (sectionEls.length === 0) return;
					scrollSpyObserver = new IntersectionObserver(function(entries) {
						entries.forEach(function(entry) {
							if (entry.isIntersecting) {
								visibleSections.add(entry.target);
							} else {
								visibleSections.delete(entry.target);
							}
						});
						updateScrollSpyHighlight();
					}, {
						rootMargin: "-80px 0px -40% 0px",
						threshold: 0
					});
					sectionEls.forEach(function(el) {
						scrollSpyObserver.observe(el);
					});
				}
				// Section nav + scroll spy
				var scrollSpyPauseTimer = null;
				document.addEventListener("DOMContentLoaded", function() {
					// Sidebar section links: auto-expand closed details on click + immediate highlight
					document.querySelectorAll(".sidebar-section-list a[href^='#']").forEach(function(link) {
						link.addEventListener("click", function() {
							var id = this.getAttribute("href").substring(1);
							var target = document.getElementById(id);
							if (target && target.tagName === "DETAILS" && !target.open) {
								target.open = true;
							}
							// Pause scroll spy to prevent immediate override
							scrollSpyPaused = true;
							if (scrollSpyPauseTimer) clearTimeout(scrollSpyPauseTimer);
							scrollSpyPauseTimer = setTimeout(function() { scrollSpyPaused = false; }, 500);
							// Immediately highlight the clicked link
							document.querySelectorAll(".sidebar-section-list a[aria-current]").forEach(function(a) {
								a.removeAttribute("aria-current");
							});
							this.setAttribute("aria-current", "true");
						});
					});
					// Setup scroll spy
					setupScrollSpy();
					// Syntax highlighting
					Prism.highlightAll();
					// Theme icon
					updateThemeIcon();
				});
			</script>
		</body>
	</html>
}
